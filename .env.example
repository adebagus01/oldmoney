# Local dev defaults — match the Docker command in the README.
# In Vercel, set these under Project Settings → Environment Variables instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oldmoney"
# Only used by Prisma CLI commands (migrate/introspect), never by the app
# at runtime. Locally it can be the same as DATABASE_URL; on Vercel with
# Neon/Vercel Postgres it must be the *unpooled* connection string — see
# the README's "Deploying to Vercel" section.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oldmoney"
