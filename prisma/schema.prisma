// Prisma schema for Old Money — a personal money tracking dashboard.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  expense
  income
}

model Category {
  id           String            @id @default(uuid())
  name         String
  type         TransactionType
  color        String
  isDefault    Boolean           @default(false)
  isFallback   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  transactions Transaction[]
}

model Transaction {
  id            String           @id @default(uuid())
  type          TransactionType
  amount        BigInt
  note          String?
  paymentMethod String?
  occurredAt    DateTime
  createdAt     DateTime         @default(now())
  // Ascending = display order in "Custom order" mode. Defaults to negative
  // creation-time millis so untouched rows sort newest-first, matching the
  // default view; manual reordering overwrites it with small sequential
  // ints for the reordered subset, and new transactions (still using the
  // very negative default) naturally land above them, at the top.
  sortOrder     BigInt           @default(0)
  category      Category         @relation(fields: [categoryId], references: [id])
  categoryId    String
}

model Setting {
  key   String @id
  value String
}
